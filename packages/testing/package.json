{
  "name": "@skillforge-ai/testing",
  "version": "1.0.0",
  "description": "Testing utilities and helpers for SkillForge AI",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts", 
      "import": "./dist/utils/index.js"
    },
    "./mocks": {
      "types": "./dist/mocks/index.d.ts",
      "import": "./dist/mocks/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures/index.d.ts",
      "import": "./dist/fixtures/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@testing-library/react": "^16.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.5.2",
    "vitest": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "jsdom": "^25.0.1",
    "msw": "^2.6.4",
    "happy-dom": "^15.11.6",
    "faker": "@faker-js/faker@^9.2.0"
  },
  "devDependencies": {
    "@skillforge-ai/core": "workspace:*",
    "@skillforge-ai/shared-state": "workspace:*",
    "@skillforge-ai/ui-kit": "workspace:*",
    "@skillforge-ai/api-client": "workspace:*",
    "@types/react": "^19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "eslint": "^9.33.0",
    "typescript": "~5.8.3"
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "@reduxjs/toolkit": "^2.4.0",
    "@tanstack/react-query": "^5.62.7"
  }
}