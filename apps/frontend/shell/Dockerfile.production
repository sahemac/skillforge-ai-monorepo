# SkillForge AI - Shell Frontend Production Dockerfile
# Basé sur docker-templates/Dockerfile.frontend-optimized
# Multi-stage build for minimal production images (~25-50MB vs ~500MB+)

# Stage 1: Dependencies
FROM node:20-alpine AS deps
WORKDIR /app

# Copy workspace configuration from monorepo root
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Install pnpm and dependencies
RUN corepack enable && \
    corepack prepare pnpm@latest --activate

# Copy shared packages needed for build
COPY packages ./packages

# Copy shell app source
COPY apps/frontend/shell ./apps/frontend/shell

# Install all dependencies from root
RUN pnpm install --frozen-lockfile

# Stage 2: Builder
FROM node:20-alpine AS builder
WORKDIR /app

# Copy dependencies and workspace structure from deps stage
COPY --from=deps /app ./

# Build application with production optimizations
ARG NODE_ENV=production
ENV NODE_ENV=${NODE_ENV}
ENV VITE_BUILD_MODE=production

# Load production environment variables
COPY apps/frontend/shell/.env.production apps/frontend/shell/.env.production

RUN corepack enable && \
    corepack prepare pnpm@latest --activate && \
    cd apps/frontend/shell && \
    pnpm build

# Stage 3: Production
FROM nginx:1.25-alpine AS production

# Install minimal runtime dependencies
RUN apk --no-cache add ca-certificates tzdata gettext && \
    rm -rf /var/cache/apk/*

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nginx -u 1001 -G nodejs

# Copy built assets from builder
COPY --from=builder --chown=nginx:nodejs /app/apps/frontend/shell/dist /usr/share/nginx/html

# Copy nginx configuration template
COPY --chown=nginx:nodejs apps/frontend/shell/nginx.conf.template /etc/nginx/conf.d/default.conf.template

# Create startup script for dynamic port configuration (Cloud Run)
# This script runs as root to configure nginx, then starts nginx as root
# (nginx will automatically drop privileges for worker processes)
RUN echo '#!/bin/sh' > /start.sh && \
    echo 'export PORT=${PORT:-8080}' >> /start.sh && \
    echo 'envsubst '\''$PORT'\'' < /etc/nginx/conf.d/default.conf.template > /etc/nginx/conf.d/default.conf' >> /start.sh && \
    echo 'exec nginx -g "daemon off;"' >> /start.sh && \
    chmod +x /start.sh

# Security: Remove default nginx files
RUN rm -f /usr/share/nginx/html/index.html \
    /etc/nginx/conf.d/default.conf

# Change ownership for nginx runtime
RUN chown -R nginx:nodejs /usr/share/nginx/html && \
    chown -R nginx:nodejs /var/cache/nginx && \
    chown -R nginx:nodejs /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown -R nginx:nodejs /var/run/nginx.pid

# Health check - use PORT variable with default 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:${PORT:-8080}/health || exit 1

# Expose dynamic port for Cloud Run (default 8080)
EXPOSE ${PORT:-8080}

# Run as root to allow port binding and config writing
# Nginx will handle worker process privileges internally
CMD ["/start.sh"]

# Labels for traceability
LABEL maintainer="SkillForge AI Team"
LABEL description="SkillForge AI Shell App - Monolithic Frontend"
LABEL version="1.0.0"
