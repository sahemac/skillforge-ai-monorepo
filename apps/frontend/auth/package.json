{
  "name": "@skillforge-ai/auth",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SkillForge AI Authentication Micro-Frontend - Module Federation Remote",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "preview": "vite preview",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@skillforge-ai/core": "workspace:*",
    "@skillforge-ai/ui-kit": "workspace:*",
    "@skillforge-ai/api-client": "workspace:*",
    "@skillforge-ai/shared": "workspace:*",
    "@skillforge-ai/shared-state": "workspace:*",
    "@skillforge-ai/testing": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^6.20.1",
    "react-hook-form": "^7.48.2",
    "@hookform/resolvers": "^3.3.2",
    "@tanstack/react-query": "^5.8.4",
    "@reduxjs/toolkit": "^2.0.1",
    "react-redux": "^9.0.4",
    "@preact/signals-react": "^2.0.0",
    "mitt": "^3.0.1",
    "zod": "^3.22.4",
    "axios": "^1.6.2",
    "jwt-decode": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@originjs/vite-plugin-federation": "^1.3.5",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.9.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2"
  }
}