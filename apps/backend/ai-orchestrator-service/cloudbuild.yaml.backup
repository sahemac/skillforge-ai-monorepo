steps:
  # Build the image with proper context from repository root
  - name: 'gcr.io/cloud-builders/docker'
    args: 
      - 'build'
      - '-f'
      - 'apps/backend/ai-orchestrator-service/Dockerfile'
      - '-t'
      - 'europe-west1-docker.pkg.dev/$PROJECT_ID/skillforge-docker-repo-staging/ai-orchestrator-service:$BUILD_ID'
      - '-t'
      - 'europe-west1-docker.pkg.dev/$PROJECT_ID/skillforge-docker-repo-staging/ai-orchestrator-service:latest'
      - '.'
    timeout: '1200s'

  # Push the images to Artifact Registry
  - name: 'gcr.io/cloud-builders/docker'
    args:
      - 'push'
      - 'europe-west1-docker.pkg.dev/$PROJECT_ID/skillforge-docker-repo-staging/ai-orchestrator-service:$BUILD_ID'
  
  - name: 'gcr.io/cloud-builders/docker'
    args:
      - 'push'
      - 'europe-west1-docker.pkg.dev/$PROJECT_ID/skillforge-docker-repo-staging/ai-orchestrator-service:latest'

  # Deploy to Cloud Run
  - name: 'gcr.io/google.com/cloudsdktool/cloud-sdk'
    entrypoint: 'gcloud'
    args:
      - 'run'
      - 'deploy'
      - 'ai-orchestrator-service'
      - '--image=europe-west1-docker.pkg.dev/$PROJECT_ID/skillforge-docker-repo-staging/ai-orchestrator-service:$BUILD_ID'
      - '--platform=managed'
      - '--region=europe-west1'
      - '--allow-unauthenticated'
      - '--port=8000'
      - '--memory=2Gi'
      - '--cpu=2'
      - '--min-instances=0'
      - '--max-instances=10'
      - '--concurrency=80'
      - '--timeout=900'
      - '--ingress=all'
      - '--set-env-vars=ENVIRONMENT=production,SERVICE_NAME=ai-orchestrator-service,POSTGRES_HOST=127.0.0.1,POSTGRES_PORT=5432,POSTGRES_DB=skillforge_db,POSTGRES_USER=skillforge_user,POSTGRES_PASSWORD=Psaumes@27,DATABASE_URL=postgresql+asyncpg://skillforge_user:Psaumes@27@127.0.0.1:5432/skillforge_db'
      - '--labels=app=skillforge,component=backend,service=ai-orchestrator,environment=production'
      - '--quiet'

images:
  - 'europe-west1-docker.pkg.dev/$PROJECT_ID/skillforge-docker-repo-staging/ai-orchestrator-service:$BUILD_ID'
  - 'europe-west1-docker.pkg.dev/$PROJECT_ID/skillforge-docker-repo-staging/ai-orchestrator-service:latest'

options:
  logging: CLOUD_LOGGING_ONLY
  machineType: 'E2_HIGHCPU_8'
  substitution_option: 'ALLOW_LOOSE'

timeout: '1800s'