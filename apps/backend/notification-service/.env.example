# Environment Configuration\nENVIRONMENT=development\nDEBUG=True\n\n# API Configuration\nAPI_V1_STR=/api/v1\nPROJECT_NAME="SkillForge AI Notification Service"\n\n# API Gateway Integration\nAPI_GATEWAY_URL=https://your-api-gateway-url.com\n\n# Database Configuration\nDATABASE_URL=postgresql+asyncpg://your_user:your_secure_password@localhost:5432/your_database\nPOSTGRES_USER=your_db_user\nPOSTGRES_PASSWORD=GENERATE_A_SECURE_PASSWORD_HERE\nPOSTGRES_DB=skillforge_notification\nPOSTGRES_HOST=localhost\nPOSTGRES_PORT=5432\n\n# Security\nSECRET_KEY=GENERATE_A_SECURE_SECRET_KEY_HERE\n\n# CORS Configuration\nBACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","https://your-domain.com"]\nALLOWED_HOSTS=["localhost","127.0.0.1","your-domain.com"]\n\n# Redis Configuration (for caching and sessions)\nREDIS_URL=redis://localhost:6379/5\nCACHE_TTL=300\n\n# External Services\nUSER_SERVICE_URL=http://user-service:8000\n\n# Service-specific Configuration\nSMTP_HOST=YOUR_SMTP_HOST_HERE\nSMTP_USER=YOUR_SMTP_USER_HERE\nSMTP_PASSWORD=YOUR_SMTP_PASSWORD_HERE\nTWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID_HERE\nTWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN_HERE\nFIREBASE_CREDENTIALS=YOUR_FIREBASE_CREDENTIALS_HERE\n\n# Monitoring\nENABLE_METRICS=True