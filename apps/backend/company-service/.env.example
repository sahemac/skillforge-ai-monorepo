# Environment Configuration
ENVIRONMENT=development
DEBUG=True

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME="SkillForge AI Company Service"

# API Gateway Integration
API_GATEWAY_URL=https://your-api-gateway-url.com

# Database Configuration
DATABASE_URL=postgresql+asyncpg://your_user:your_secure_password@localhost:5432/your_database
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=GENERATE_A_SECURE_PASSWORD_HERE
POSTGRES_DB=skillforge_company
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Security
SECRET_KEY=GENERATE_A_SECURE_SECRET_KEY_HERE

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","https://your-domain.com"]
ALLOWED_HOSTS=["localhost","127.0.0.1","your-domain.com"]

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379/2
CACHE_TTL=300

# External Services
USER_SERVICE_URL=http://user-service:8000

# Monitoring
ENABLE_METRICS=True