# Environment Configuration
ENVIRONMENT=development
DEBUG=True

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME="SkillForge AI Orchestrator Service"

# Database Configuration
# IMPORTANT: Never commit real credentials to git!
DATABASE_URL=postgresql+asyncpg://your_user:your_secure_password@localhost:5432/your_database
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=GENERATE_A_SECURE_PASSWORD_HERE
POSTGRES_DB=skillforge_ai_orchestrator
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Security & Authentication
# IMPORTANT: Generate a secure secret key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=GENERATE_A_SECURE_SECRET_KEY_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","https://your-domain.com"]
ALLOWED_HOSTS=["localhost","127.0.0.1","your-domain.com"]

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# AI Services Configuration
# IMPORTANT: Get API keys from respective providers
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
GOOGLE_AI_API_KEY=YOUR_GOOGLE_AI_API_KEY_HERE
HUGGINGFACE_API_KEY=YOUR_HUGGINGFACE_API_KEY_HERE

# AI Models Configuration
DEFAULT_LANGUAGE_MODEL=gpt-4
DEFAULT_EMBEDDING_MODEL=text-embedding-ada-002
MAX_TOKENS=4000
TEMPERATURE=0.7

# Agent Configuration
MAX_CONCURRENT_AGENTS=10
AGENT_TIMEOUT_SECONDS=300
TASK_QUEUE_SIZE=100

# Vector Database Configuration
VECTOR_DB_URL=http://localhost:8000
VECTOR_DB_COLLECTION=ai_knowledge_base

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# External Services
USER_SERVICE_URL=http://user-service:8000
CONTENT_SERVICE_URL=http://content-service:8000
NOTIFICATION_SERVICE_URL=http://notification-service:8000

# Monitoring
ENABLE_METRICS=True
METRICS_PORT=9090

# Testing
TEST_DATABASE_URL=postgresql+asyncpg://test:test@localhost:5432/skillforge_ai_orchestrator_test