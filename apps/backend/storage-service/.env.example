# Environment Configuration\nENVIRONMENT=development\nDEBUG=True\n\n# API Configuration\nAPI_V1_STR=/api/v1\nPROJECT_NAME="SkillForge AI Storage Service"\n\n# API Gateway Integration\nAPI_GATEWAY_URL=https://your-api-gateway-url.com\n\n# Database Configuration\nDATABASE_URL=postgresql+asyncpg://your_user:your_secure_password@localhost:5432/your_database\nPOSTGRES_USER=your_db_user\nPOSTGRES_PASSWORD=GENERATE_A_SECURE_PASSWORD_HERE\nPOSTGRES_DB=skillforge_storage\nPOSTGRES_HOST=localhost\nPOSTGRES_PORT=5432\n\n# Security\nSECRET_KEY=GENERATE_A_SECURE_SECRET_KEY_HERE\n\n# CORS Configuration\nBACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","https://your-domain.com"]\nALLOWED_HOSTS=["localhost","127.0.0.1","your-domain.com"]\n\n# Redis Configuration (for caching and sessions)\nREDIS_URL=redis://localhost:6379/9\nCACHE_TTL=300\n\n# External Services\nUSER_SERVICE_URL=http://user-service:8000\n\n# Service-specific Configuration\nAWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID_HERE\nAWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY_HERE\nAWS_S3_BUCKET=YOUR_AWS_S3_BUCKET_HERE\nAZURE_STORAGE_CONNECTION_STRING=YOUR_AZURE_STORAGE_CONNECTION_STRING_HERE\nGCS_BUCKET_NAME=YOUR_GCS_BUCKET_NAME_HERE\n\n# Monitoring\nENABLE_METRICS=True