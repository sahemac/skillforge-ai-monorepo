# SkillForge AI Payment Service Configuration

# Environment
ENVIRONMENT=development
DEBUG=true

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME="SkillForge AI Payment Service"
API_GATEWAY_URL=http://localhost:8000

# Security
SECRET_KEY=your-secure-secret-key-here
ENCRYPTION_KEY=your-base64-encryption-key-here

# CORS Origins (JSON array format)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","https://your-domain.com"]
ALLOWED_HOSTS=["localhost","127.0.0.1","your-domain.com"]

# Database Configuration
POSTGRES_USER=skillforge_user
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=skillforge_payment
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://skillforge_user:your-secure-password-here@localhost:5432/skillforge_payment
DATABASE_ENCRYPTION=true

# Redis Configuration
REDIS_URL=redis://localhost:6379/4
CACHE_TTL=300

# External Services
SUBSCRIPTION_SERVICE_URL=http://subscription-service:8000
USER_SERVICE_URL=http://user-service:8000
NOTIFICATION_SERVICE_URL=http://notification-service:8000

# Payment Provider Configuration
# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# PayPal Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# Invoice & PDF Configuration
INVOICE_TEMPLATE_PATH=templates/invoices
PDF_STORAGE_PATH=/tmp/invoices

# Celery Configuration for Background Jobs
CELERY_BROKER_URL=redis://localhost:6379/5
CELERY_RESULT_BACKEND=redis://localhost:6379/6

# Rate Limiting
RATE_LIMIT_ENABLED=true
PAYMENT_RATE_LIMIT=10/minute

# Business Configuration
DEFAULT_CURRENCY=EUR
SUPPORTED_CURRENCIES=["EUR","USD","GBP"]
DEFAULT_TAX_RATE=0.20
TAX_ENABLED=true

# Invoice Configuration
INVOICE_PREFIX=SF
INVOICE_NUMBER_LENGTH=8

# Webhook Configuration
WEBHOOK_TIMEOUT=30
MAX_WEBHOOK_RETRIES=3

# Monitoring
ENABLE_METRICS=true