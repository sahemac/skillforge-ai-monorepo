# Environment Configuration
ENVIRONMENT=development
DEBUG=True

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME="SkillForge AI User Service"

# Database Configuration
# IMPORTANT: Never commit real credentials to git!
DATABASE_URL=postgresql+asyncpg://your_user:your_secure_password@localhost:5432/your_database
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=GENERATE_A_SECURE_PASSWORD_HERE
POSTGRES_DB=skillforge_users
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Security & Authentication
# IMPORTANT: Generate a secure secret key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=GENERATE_A_SECURE_SECRET_KEY_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","https://your-domain.com"]
ALLOWED_HOSTS=["localhost","127.0.0.1","your-domain.com"]

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# Email Configuration
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=YOUR_EMAIL_APP_PASSWORD_HERE
EMAILS_FROM_EMAIL=noreply@your-domain.com
EMAILS_FROM_NAME="SkillForge AI"

# First Superuser
FIRST_SUPERUSER=admin@your-domain.com
FIRST_SUPERUSER_PASSWORD=GENERATE_A_SECURE_ADMIN_PASSWORD_HERE

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_PATH=/tmp/uploads

# External Services
NOTIFICATION_SERVICE_URL=http://notification-service:8001
EMAIL_SERVICE_URL=http://email-service:8002

# Monitoring
ENABLE_METRICS=True
METRICS_PORT=9090

# Testing
TEST_DATABASE_URL=postgresql+asyncpg://test:test@localhost:5432/skillforge_users_test