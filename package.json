{
  "name": "skillforge-ai-monorepo",
  "version": "1.0.0", 
  "private": true,
  "type": "module",
  "description": "SkillForge AI Monorepo",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/frontend/*"
    ]
  },
  "scripts": {
    "build:packages": "pnpm -r --filter './packages/*' build",
    "build:frontend": "pnpm -r --filter './apps/frontend/*' build",
    "build:all": "pnpm run build:packages && pnpm run build:frontend",
    "dev:shell": "pnpm --filter shell dev",
    "install:all": "pnpm install"
  },
  "devDependencies": {
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "esbuild": "0.25.10",
      "react": "^18.3.1",
      "react-dom": "^18.3.1",
      "@types/react": "^18.3.5",
      "@types/react-dom": "^18.3.0"
    }
  }
}